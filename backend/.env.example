# Copy this file to backend/.env and fill in real values there.
# backend/.env is gitignored - it is never committed.

# Connection string for the app's database (users, sessions, saved connections,
# jobs, results). SQL Server, via pyodbc.
# Windows Authentication (local dev):
#   mssql+pyodbc://@<host>[\<instance>]/<dbname>?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&Encrypt=yes&TrustServerCertificate=yes
# SQL login (e.g. Azure SQL Database):
#   mssql+pyodbc://<username>:<password>@<host>:1433/<dbname>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
DATABASE_URL=

# Fernet key encrypting saved connections' credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEY=

# ── Optional overrides (defaults shown) ───────────────────────
# USERS_TABLE_SCHEMA=dbo
# SESSION_TTL_SECONDS=28800
# SESSION_COOKIE_SECURE=false
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Data-quality rules (defaults shown) ───────────────────────
# DQ_DEFAULT_PARALLEL_TABLES=4
# DQ_MAX_PARALLEL_TABLES=16
# DQ_MAX_EXPRS_PER_PASS=400
# DQ_RUN_WORKERS=2
# DQ_DRY_RUN_MAX_TABLES=200

# ── Windows only, DQ engine (PySpark) ─────────────────────────
# Only needed if a job fails to start with "The system cannot find the path
# specified" - see README.md's setup checklist.
# JAVA_HOME=C:\Program Files\Java\<the JDK folder that actually exists>
# SPARK_HOME=<repo>\venv\Lib\site-packages\pyspark
# PYSPARK_PYTHON=<repo>\venv\Scripts\python.exe
